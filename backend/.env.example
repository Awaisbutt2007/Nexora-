PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# HOSTED WEB APP
# When the React build exists (../dist, created by `npm run build`) this server also
# serves it, so opening http://localhost:8787 runs the whole product as ONE process on
# ONE origin — the page calls relative /api URLs and CORS can never break a request.
# HOSTED_CLIENT=0     API only (leave the app to Vite / a static host)
# CLIENT_DIR=...      point at a different build folder

# AUTH SECRET — the value below is a dev-only placeholder. In production the
# server REFUSES TO START unless JWT_SECRET is set to a strong random value
# (and CORS_ORIGIN is not localhost). Generate one: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=nexora-dev-secret-change-me
JWT_EXPIRES_IN=7d

# Frontend origin — only matters when the app is served from ANOTHER address and calls
# absolute URLs. Out of the box it does not: the page is same-origin (Vite proxies /api in
# dev, this server hosts the build in production), so CORS is never in the picture.
# Comma-separated exact origins. In DEVELOPMENT local origins (any localhost port and
# RFC 1918 LAN addresses like http://192.168.x.x:5173) are reflected automatically, because
# an unlisted origin shows up in the browser as a mysterious "Failed to fetch".
CORS_ORIGIN=http://localhost:5173

# OpenAI-compatible provider (optional — mock streaming works without a key)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# OPTIONAL vision model for chat turns that carry a user-attached image (pasted
# or uploaded). Leave blank to reuse OPENAI_MODEL — gpt-4o-mini and Groq's
# qwen/qwen3.8-27b already read images. Set this only if OPENAI_MODEL is text-only.
AI_VISION_MODEL=

# WHO BUILT THE COMPANION (identity)
# Every chat and voice reply is pinned to this creator name: asked "who made you?"
# it always answers this name and never credits OpenAI/GPT/Claude/Google, and asked
# HOW it was built it stays deliberately vague (the stack, model, prompts and keys
# are never revealed). Leave blank to use the shipped default "Awais".
AI_DEVELOPER_NAME=Awais

# WHAT /health DISCLOSES
# By default the public health probe reports readiness only — no engine name, no voice
# model, no provider — because that endpoint answers without a token. Set it to 1 on
# your own machine when you want the full parts list for debugging. NEVER set this in
# a public deployment.
# HEALTH_VERBOSE=1

# IMAGE GENERATION (Pollinations, keyless)
# Chat + the Image Generator tool render pictures through /api/images/generate.
# The free ANONYMOUS tier now sheds most requests with a 402 "at its limit" wall,
# so images are unreliable without a token. Get a FREE token at
# https://enter.pollinations.ai and paste it below to lift the cap and make
# generation reliable. Leave blank to keep trying anonymously (honest "busy"
# errors when the free tier is saturated) — the token never reaches the browser.
POLLINATIONS_TOKEN=

# Monthly free credits for new accounts
FREE_MONTHLY_CREDITS=5000

# Google OAuth Client ID (for Sign in with Google)
# Create at https://console.cloud.google.com/apis/credentials -> OAuth client ID -> Web application
# Authorized JavaScript origin: http://localhost:5173
GOOGLE_CLIENT_ID=

# Voice print / speaker verification (Sections 7-8)
# Cosine-similarity pass mark (0..1) for POST /api/voice/verify
VOICE_MATCH_THRESHOLD=0.8
# Optional SpeechBrain-style x-vector service URL; leave empty to use local DSP embeddings
SPEECHBRAIN_URL=

# Realtime voice calls (Aira speaking live). Requires a REAL OPENAI_API_KEY above —
# voice has no mock mode, it will never play placeholder audio.
# Provider is pluggable; currently only "openai-realtime" is implemented.
VOICE_PROVIDER=openai-realtime
# Speech-to-speech model (docs: gpt-realtime-2.1; "-mini" variant is cheaper)
VOICE_REALTIME_MODEL=gpt-realtime-2.1
# Default voice: marin (warm female, recommended) — also alloy ash ballad
# coral echo sage shimmer verse cedar
VOICE_VOICE=marin
# Speech tempo: multiple of the model's natural pace (0.25..1.5, provider default
# 1.0). Shipped at 1.1 so Aira sounds brisk without rushing. Raise to ~1.15 if
# still too slow, drop toward 1.0 if it sounds hurried.
VOICE_OUTPUT_SPEED=1.1
# How quickly Aira begins replying after you stop: low | medium | high (max wait
# 8s / 4s / 2s). medium is the safe default; high is snappier but may cut in on
# your pauses.
VOICE_TURN_EAGERNESS=medium
# ASR model used for live captions + transcript persistence
VOICE_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Hard cap per voice call in seconds (provider session max is 3600)
VOICE_MAX_SESSION_SECONDS=1800
# Max fresh voice sessions per user per 10 minutes
VOICE_RATE_LIMIT_PER_10MIN=5

# ---- Auth brute-force protection (in-memory sliding window) ----
# Max login/register attempts per email+IP and per IP over the window.
AUTH_RATE_LIMIT=8
AUTH_IP_RATE_LIMIT=30
AUTH_RATE_WINDOW_SECONDS=300

# ---- Open demo auth ----
# ON by default: ANY email/password signs in (unknown emails auto-create an
# account, wrong passwords are ignored) so the app is always demoable.
# Set to 0 to restore strict email/password validation.
AUTH_OPEN_MODE=1
# ---- AI endpoint throttle (expensive: chat / proactive / tool runs) ----
# Max requests per user per window. Credits cap total spend; this caps burst.
AI_RATE_LIMIT_PER_MIN=20
AI_RATE_WINDOW_SECONDS=60
# Set true ONLY when running behind a reverse proxy (Render/Fly/nginx) so the
# limiter reads the real client IP. Auto-on when NODE_ENV=production.
TRUST_PROXY=false

# ---- Desktop agent bridge (Aira → local Windows desktop agent) ----
# The backend is the only thing that may talk to the desktop agent; the browser
# never sees this secret. Leave DESKTOP_AGENT_SECRET empty to keep the bridge
# disabled (all /api/desktop/* calls return a clear "disabled/unavailable" error).
# The URL MUST be loopback (127.0.0.1/localhost) — the agent runs on this same PC.
# Set DESKTOP_AGENT_SECRET to the SAME value as desktop-agent/.env AGENT_SECRET.
DESKTOP_AGENT_URL=http://127.0.0.1:8799
DESKTOP_AGENT_SECRET=
# Client-side timeout for proxied agent calls (a hung agent can't wedge requests).
DESKTOP_AGENT_TIMEOUT_MS=65000
