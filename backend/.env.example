PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# AUTH SECRET — the value below is a dev-only placeholder. In production the
# server REFUSES TO START unless JWT_SECRET is set to a strong random value
# (and CORS_ORIGIN is not localhost). Generate one: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=nexora-dev-secret-change-me
JWT_EXPIRES_IN=7d

# Frontend origin (Vite default)
CORS_ORIGIN=http://localhost:5173

# OpenAI-compatible provider (optional — mock streaming works without a key)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Monthly free credits for new accounts
FREE_MONTHLY_CREDITS=5000

# Google OAuth Client ID (for Sign in with Google)
# Create at https://console.cloud.google.com/apis/credentials -> OAuth client ID -> Web application
# Authorized JavaScript origin: http://localhost:5173
GOOGLE_CLIENT_ID=

# Voice print / speaker verification (Sections 7-8)
# Cosine-similarity pass mark (0..1) for POST /api/voice/verify
VOICE_MATCH_THRESHOLD=0.8
# Optional SpeechBrain-style x-vector service URL; leave empty to use local DSP embeddings
SPEECHBRAIN_URL=

# Realtime voice calls (Aira speaking live). Requires a REAL OPENAI_API_KEY above —
# voice has no mock mode, it will never play placeholder audio.
# Provider is pluggable; currently only "openai-realtime" is implemented.
VOICE_PROVIDER=openai-realtime
# Speech-to-speech model (docs: gpt-realtime-2.1; "-mini" variant is cheaper)
VOICE_REALTIME_MODEL=gpt-realtime-2.1
# Default voice: marin (warm female, recommended) — also alloy ash ballad
# coral echo sage shimmer verse cedar
VOICE_VOICE=marin
# Speech tempo: multiple of the model's natural pace (0.25..1.5, provider default
# 1.0). Shipped at 1.1 so Aira sounds brisk without rushing. Raise to ~1.15 if
# still too slow, drop toward 1.0 if it sounds hurried.
VOICE_OUTPUT_SPEED=1.1
# How quickly Aira begins replying after you stop: low | medium | high (max wait
# 8s / 4s / 2s). medium is the safe default; high is snappier but may cut in on
# your pauses.
VOICE_TURN_EAGERNESS=medium
# ASR model used for live captions + transcript persistence
VOICE_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Hard cap per voice call in seconds (provider session max is 3600)
VOICE_MAX_SESSION_SECONDS=1800
# Max fresh voice sessions per user per 10 minutes
VOICE_RATE_LIMIT_PER_10MIN=5

# ---- Auth brute-force protection (in-memory sliding window) ----
# Max login/register attempts per email+IP and per IP over the window.
AUTH_RATE_LIMIT=8
AUTH_IP_RATE_LIMIT=30
AUTH_RATE_WINDOW_SECONDS=300
# Set true ONLY when running behind a reverse proxy (Render/Fly/nginx) so the
# limiter reads the real client IP. Auto-on when NODE_ENV=production.
TRUST_PROXY=false
