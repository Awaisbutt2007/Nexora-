# ─────────────────────────────────────────────────────────────────────────────
# Nexora Desktop Agent — configuration
# Copy this file to `.env` (which is git-ignored) and fill in real values.
# The agent REFUSES TO START with a missing secret or a non-loopback host.
# ─────────────────────────────────────────────────────────────────────────────

# Network binding. SECURITY: only a loopback address is allowed. The agent will
# abort if AGENT_HOST is anything other than 127.0.0.1 / ::1 / localhost, so the
# automation surface is never reachable from another machine on your network.
AGENT_HOST=127.0.0.1
AGENT_PORT=8799

# Shared secret between the Aira backend and this agent. Every mutating request
# to the agent must carry `Authorization: Bearer <this value>`. Put the SAME
# value in backend/.env as DESKTOP_AGENT_SECRET. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_SECRET=

# How many milliseconds an action may run before it is cancelled and reported as
# a timeout. Every action can override this with a smaller value, never larger.
AGENT_ACTION_TIMEOUT_MS=60000

# Absolute directory (or comma-separated list) the agent may READ/LIST/ORGANIZE.
# File operations are REJECTED for any path outside these roots (containment is
# enforced after realpath, so symlink escapes are blocked). Leave empty to keep
# file access denied by default until you add it here or grant it at runtime.
# Example: AGENT_ALLOWED_DIRS=D:\NexoraPlayground
AGENT_ALLOWED_DIRS=

# Absolute folder (or comma-separated list) of approved development tools that
# may be launched by name. Apps are started ONLY from the built-in allowlist
# below mapped to real executables — never from a raw command string. To allow a
# project folder to open in VS Code you must also list it in AGENT_ALLOWED_DIRS.
AGENT_APPROVED_APP_IDS=vscode,chrome,notepad

# Playwright automation. A DEDICATED profile is used so the automation never
# touches your real browser logins, cookies, saved passwords or history.
AGENT_BROWSER=headless chromium
AGENT_BROWSER_PROFILE=./browser-profile
# Only these origins may the browser open (comma-separated hosts). Empty = any
# public http(s) site; set it to lock browsing to an approved allowlist.
AGENT_ALLOWED_HOSTS=

# Where the redacted audit trail is written (one JSON object per line). It never
# stores secrets, passwords, tokens, cookie values, or file bodies.
AGENT_AUDIT_DIR=./audit

# Persistence for granted permissions (default-deny; grants are narrow scopes).
AGENT_DATA_DIR=./data
