# Frontend (Vite) environment — SAFE EXAMPLE ONLY. Copy to `.env` for local use.
# Anything prefixed VITE_ is BAKED INTO THE BROWSER BUNDLE at build time.
# NEVER put a secret, API key or token here — those belong only in backend/.env.

# Backend API base URL the app talks to (public, non-secret).
# LEAVE THIS EMPTY (or delete the line) for local development: Vite then proxies /api
# and /uploads to http://localhost:8787, so requests are same-origin and no CORS rule
# can break them from another port or a LAN address. Set it only when the app must call
# a backend that lives somewhere else (e.g. a deployed URL).
# VITE_API_URL=http://localhost:8787

# Google OAuth client ID used by "Sign in with Google". This ID is public by
# design (it is not a secret); the secret half lives only on Google's side.
VITE_GOOGLE_CLIENT_ID=
