{
  "name": "secrect-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:api": "npm --prefix backend run dev",
    "start:api": "npm --prefix backend start",
    "dev:agent": "npm --prefix desktop-agent run dev",
    "start:agent": "npm --prefix desktop-agent start",
    "build": "vite build",
    "lint": "oxlint",
    "test": "npm --prefix backend test",
    "test:api": "npm --prefix backend test",
    "test:agent": "npm --prefix desktop-agent test",
    "security:scan": "node scripts/secret-scan.mjs",
    "security:scan:history": "node scripts/secret-scan.mjs --history",
    "security:check": "node scripts/security-check.mjs",
    "security:check:full": "node scripts/security-check.mjs --history",
    "audit:all": "npm audit --omit=dev && npm --prefix backend audit --omit=dev && npm --prefix desktop-agent audit --omit=dev",
    "preview": "vite preview"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
